---
import { exampleCatalog } from "../../../examples/catalog.ts";
import { landingCode } from "../landing-code.ts";
import {
  siteDescription,
  siteTitle,
  shareImagePath,
  shareImageWidth,
  shareImageHeight,
  shareImageAlt,
} from "../../site-branding.mjs";

const base = import.meta.env.BASE_URL;
const path = (value: string) => `${base}${value}`.replace(/\/+/g, "/");
// Astro's dev router does not resolve public directory indexes; static hosts do.
const examplePath = (slug: string) => path(`examples/${slug}/${import.meta.env.DEV ? "index.html" : ""}`);
const repositoryUrl = import.meta.env.PUBLIC_REPOSITORY_URL ?? "https://github.com/vp-tw/dirwell";
const examples = exampleCatalog;
const canonicalUrl = new URL(base, Astro.site);
const shareImageUrl = new URL(path(shareImagePath), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={siteDescription} />
    <meta name="theme-color" content="#f3f0e8" />
    <title>{siteTitle}</title>
    <link rel="icon" type="image/png" sizes="1254x1254" href={path("brand/paper-bird.png")} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dirwell" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={shareImageWidth} />
    <meta property="og:image:height" content={shareImageHeight} />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={shareImageUrl} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
    <link rel="stylesheet" href={path("landing.css")} />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="Dirwell home">
        <img src={path("brand/paper-bird.png")} alt="" width="36" height="36" />
        <span class="wordmark-name">dirwell<span>/</span></span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#examples">Examples</a>
        <a href={path("getting-started/")}>Docs</a>
        <a href={repositoryUrl}>GitHub</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-intro">
          <div class="hero-copy">
            <h1 id="hero-title">Put a directory<br />on the web.</h1>
            <p>
              Dirwell builds a static file explorer from the folders and files you already have. Browse release downloads, reports, or build artifacts. Publish the generated files on a static host.
            </p>
            <div class="actions">
              <a class="primary-action" href={path("getting-started/")}>Build your first explorer</a>
              <a class="text-action" href="#examples">See working examples</a>
            </div>
          </div>

          <div class="hero-visual">
            <img
              class="hero-mascot"
              src={path("brand/paper-bird.png")}
              alt="Dirwell’s curious bird, folded from a cream paper page with an orange wing."
              width="1254"
              height="1254"
              fetchpriority="high"
            />
            <div class="terminal" aria-label="Dirwell quick start command">
              <div class="terminal-bar"><span>terminal</span><span>Node.js 26+</span></div>
              <pre><code class="language-shell">{landingCode.terminal.map((token) =>
                token.tone ? <span class={`syntax-${token.tone}`}>{token.text}</span> : token.text
              )}</code></pre>
            </div>
          </div>
        </div>

        <div class="explorer-sample">
          <div class="sample-caption">
            <span>Default theme · generated from the file-icons preview</span>
            <a href={examplePath("file-icons")} target="_blank" rel="noopener">Open full explorer</a>
          </div>
          <iframe
            id="default-theme-preview"
            title="Interactive Dirwell default theme preview"
            src={examplePath("file-icons")}
            data-build-id-url={path("examples/.build-id")}
            loading="lazy"
          ></iframe>
        </div>
      </section>

      <section class="quick-start" aria-labelledby="quick-title">
        <div class="section-heading">
          <h2 id="quick-title">Browse your folder. Then publish it.</h2>
          <p>Requires Node.js 26 or later. Use the published package; no clone or config file is needed.</p>
        </div>
        <div class="command-pair">
          <div><span>Preview and watch</span><code>npx @vp-tw/dirwell serve ./downloads</code></div>
          <div><span>Build static output</span><code>npx @vp-tw/dirwell build ./downloads -o ./site-downloads</code></div>
        </div>
        <a class="text-action" href={path("getting-started/")}>Follow the getting-started guide</a>
      </section>

      <section class="problem" aria-labelledby="problem-title">
        <div>
          <h2 id="problem-title">The folder already has the information.</h2>
          <p>
            Most directory listings lose the context people need, or turn a small publishing
            job into an application. Dirwell keeps the filesystem legible and the output static.
          </p>
        </div>
        <dl>
          <div><dt>Start</dt><dd>No config file required.</dd></div>
          <div><dt>Inspect</dt><dd>Full metadata and explicit symlink states.</dd></div>
          <div><dt>Ship</dt><dd>Plain files for any static host.</dd></div>
          <div><dt>Adapt</dt><dd>Replace components or the renderer.</dd></div>
        </dl>
      </section>

      <section class="examples" id="examples" aria-labelledby="examples-title">
        <div class="section-heading">
          <h2 id="examples-title">Choose an example to try.</h2>
          <p>Open the generated site, then inspect the exact source that produced it.</p>
        </div>
        <div class="example-list">
          {examples.map((example) => (
            <article>
              <div>
                <h3>{example.name}</h3>
                <p>{example.description}</p>
                <span class="example-detail">{example.detail}</span>
              </div>
              <div class="example-actions">
                <a href={examplePath(example.slug)} target="_blank" rel="noopener">Live demo</a>
                <a href={`${repositoryUrl}/tree/main/examples/${example.slug}`} target="_blank" rel="noopener">GitHub source</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="depth" aria-labelledby="depth-title">
        <div class="depth-intro">
          <h2 id="depth-title">Customize when your project needs it.</h2>
          <p>
            Start with the default explorer. Later, change its theme, choose a deployment path,
            or connect it to an existing build.
          </p>
        </div>
        <div class="code-panel">
          <div class="code-tabs" role="tablist" aria-label="Configuration examples">
            <button id="tab-theme" type="button" role="tab" aria-selected="true" aria-controls="panel-theme" tabindex="0" data-tab="theme">Theme</button>
            <button id="tab-urls" type="button" role="tab" aria-selected="false" aria-controls="panel-urls" tabindex="-1" data-tab="urls">URLs</button>
            <button id="tab-naming" type="button" role="tab" aria-selected="false" aria-controls="panel-naming" tabindex="-1" data-tab="naming">Naming</button>
          </div>
          <pre id="panel-theme" role="tabpanel" aria-labelledby="tab-theme" data-panel="theme"><code class="language-typescript">{landingCode.theme.map((token) =>
            token.tone ? <span class={`syntax-${token.tone}`}>{token.text}</span> : token.text
          )}</code></pre>
          <pre id="panel-urls" role="tabpanel" aria-labelledby="tab-urls" data-panel="urls" hidden><code class="language-typescript">{landingCode.urls.map((token) =>
            token.tone ? <span class={`syntax-${token.tone}`}>{token.text}</span> : token.text
          )}</code></pre>
          <pre id="panel-naming" role="tabpanel" aria-labelledby="tab-naming" data-panel="naming" hidden><code class="language-typescript">{landingCode.naming.map((token) =>
            token.tone ? <span class={`syntax-${token.tone}`}>{token.text}</span> : token.text
          )}</code></pre>
        </div>
        <div class="depth-links">
          <a href={path("configuration/")}>Configuration reference</a>
          <a href={path("themes/")}>Theme components</a>
          <a href={path("deployment/")}>Deployment patterns</a>
          <a href={path("support/")}>Support and compatibility</a>
        </div>
      </section>

      <section class="closing" aria-labelledby="closing-title">
        <h2 id="closing-title">A directory can be the product.</h2>
        <p>Keep it static. Make it navigable. Change only what your project needs.</p>
        <a class="primary-action" href={path("getting-started/")}>Get started</a>
      </section>
    </main>

    <footer class="site-footer">
      <span>Dirwell · MIT</span>
      <div><a href={path("overview/")}>Docs</a><a href={repositoryUrl}>Source</a></div>
    </footer>

    <script>
      if (import.meta.env.DEV) {
        const preview = document.querySelector<HTMLIFrameElement>("#default-theme-preview");
        const buildIdUrl = preview?.dataset.buildIdUrl;
        let lastBuildId: string | undefined;
        if (preview && buildIdUrl) {
          window.setInterval(async () => {
            if (document.hidden) return;
            try {
              const response = await fetch(buildIdUrl, { cache: "no-store" });
              if (!response.ok) return;
              const buildId = await response.text();
              if (lastBuildId && buildId !== lastBuildId) preview.contentWindow?.location.reload();
              lastBuildId = buildId;
            } catch {
              // Keep the current preview visible while the development server restarts.
            }
          }, 1000);
        }
      }

      const tabs = Array.from(document.querySelectorAll('[role="tab"]'));
      const panels = Array.from(document.querySelectorAll("[data-panel]"));
      const selectTab = (tab) => {
          const active = tab.getAttribute("data-tab");
          for (const item of tabs) {
            const selected = item === tab;
            item.setAttribute("aria-selected", String(selected));
            item.setAttribute("tabindex", selected ? "0" : "-1");
          }
          for (const panel of panels) panel.toggleAttribute("hidden", panel.getAttribute("data-panel") !== active);
      };
      for (const tab of tabs) {
        tab.addEventListener("click", () => selectTab(tab));
        tab.addEventListener("keydown", (event) => {
          const current = tabs.indexOf(tab);
          const next =
            event.key === "ArrowRight" ? (current + 1) % tabs.length
            : event.key === "ArrowLeft" ? (current - 1 + tabs.length) % tabs.length
            : event.key === "Home" ? 0
            : event.key === "End" ? tabs.length - 1
            : null;
          if (next === null) return;
          event.preventDefault();
          selectTab(tabs[next]);
          tabs[next].focus();
        });
      }
    </script>
  </body>
</html>
