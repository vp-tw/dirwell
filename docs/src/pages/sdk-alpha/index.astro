---
const target = `${import.meta.env.BASE_URL}sdk/`.replace(/\/+/g, "/");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>SDK guide</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.search + location.hash);
    </script>
    <meta http-equiv="refresh" content={`1;url=${target}`} />
  </head>
  <body><a href={target}>Continue to the SDK guide</a></body>
</html>
