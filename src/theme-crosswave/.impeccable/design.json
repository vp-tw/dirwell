  "narrative": {
    "northStar": "The Midnight Media Shelf",
    "overview": "Crosswave is an independent, opt-in packaged theme. Its midnight ground, thin white geometric icons, satin light ribbons, and quiet sans labels make a directory read as a media shelf. The user-pinned PSP crossbar interaction places categories on the horizontal axis and files on the vertical axis.\n\nNative file links, source names, link states, and actual metadata remain the content. Broad space separates the selected row from its detail panel. This document records the implemented Crosswave world only; the documentation site, Ledger, and Plain retain their own systems.",
    "keyCharacteristics": [
      "Horizontal category rail and vertical file list.",
      "Six dark ambient palettes with bright text.",
      "Original inline SVG geometry and procedural light; no shipped raster artwork.",
      "Visible focus, IME-safe search, reduced motion, and static fallbacks."
    ],
    "rules": [
      {
        "name": "The Light Ground Rule",
        "body": "Keep the foreground bright across every palette and its selected-row wash. Atmospheric ribbons remain behind readable file content.",
        "section": "colors"
      },
      {
        "name": "The Two Axes Rule",
        "body": "Categories move horizontally; file selection moves vertically. Narrow layouts retain both axes.",
        "section": "layout"
      },
      {
        "name": "The Shared Background Rule",
        "body": "Enhanced directory exchanges move file content inside the persistent shell while the shader canvas, category rail, footer, and controller loop remain mounted. Full-document fallback retains separate background and header view-transition identities.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve native links, real filenames, and explicit symlink states.",
      "Do use the horizontal rail and vertical file column at every screen size.",
      "Do preserve the white focus outline and the reduced-motion/static fallbacks.",
      "Do keep this palette, type stack, and motion vocabulary scoped to Crosswave."
    ],
    "donts": [
      "Don't add copied console artwork, simulated system indicators, or autoplay audio.",
      "Don't replace the procedural ribbon with a shipping raster asset.",
      "Don't hide file reachability behind the detail panel or controller support.",
