{
  "name": "@dirwell/cli",
  "version": "0.0.6",
  "description": "Minimal file explorer build and live-server commands with Plain included.",
  "homepage": "https://vp-tw.github.io/dirwell/getting-started/",
  "bugs": {
    "url": "https://github.com/vp-tw/dirwell/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vp-tw/dirwell.git",
    "directory": "packages/cli"
  },
  "bin": {
    "dirwell": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "latest"
  },
  "scripts": {
    "build": "vp pack"
  },
  "dependencies": {
    "@dirwell/core": "workspace:*",
    "@dirwell/server": "workspace:*",
    "@dirwell/theme-plain": "workspace:*",
    "import-meta-resolve": "4.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
