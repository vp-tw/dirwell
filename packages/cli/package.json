{
  "name": "@dirwell/cli",
  "version": "0.0.1-alpha",
  "private": true,
  "description": "Explicit-theme build and live-server commands for Dirwell.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vp-tw/dirwell.git",
